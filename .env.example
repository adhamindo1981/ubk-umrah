# ==============================================================================
# UBK Umrah - Environment Configuration Template (.env.example)
# ملاحظة: هذا الملف للمثال التوضيحي فقط، لا تضع أي مفاتيح حقيقية هنا
# ==============================================================================

# Database Connection URL (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth Configuration
# قم بتوليد مفتاح عشوائي مشفر قوي عبر: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-byte-or-longer-random-secret-key-here"
NEXTAUTH_URL="https://your-domain.vercel.app"

# JWT Secret (Must match or complement NEXTAUTH_SECRET)
JWT_SECRET="your-jwt-secret-key-here"

# SMTP Email Configuration (Nodemailer)
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="noreply@example.com"
EMAIL_PASS="your-smtp-secure-password"

# Public Site Configuration (Safe for client-side)
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_OFFICIAL_BANK_NAME="Bank Syariah Indonesia (BSI)"
NEXT_PUBLIC_OFFICIAL_BANK_ACCOUNT="7200-8899-1001"
NEXT_PUBLIC_OFFICIAL_BANK_HOLDER="PT. UMAR BIN AL-KHATTAB FOR UMRAH"
